# Groq key pool -- add as many GROQ_API_KEY_N vars as you have keys.
# llm_client.py round-robins across all of them before falling back to OpenRouter.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# OpenRouter fallback -- used only if every Groq key in the pool fails.
OPENROUTER_API_KEY=

# Optional: persist Dagster run/sensor history across `dagster dev` restarts.
# Point this at a local folder, e.g. .dagster_home
# DAGSTER_HOME=
